# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ootaint-bin
_pkgname=ootaint
pkgver=0.1.0
pkgrel=1
pkgdesc="Information flow control tracker tracking tainted data paths across pipes."
arch=('x86_64')
url="https://github.com/openOODA-tools/ootaint"
license=('Apache-2.0')
depends=('glibc')
provides=('ootaint')
conflicts=('ootaint')
source_x86_64=("${url}/releases/download/v${pkgver}/ootaint-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ootaint-linux-x86_64" "${pkgdir}/usr/bin/ootaint"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ootaint-uninstall"
}
